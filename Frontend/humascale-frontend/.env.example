# Backend API base URL.
# In development, leave empty to use the Vite dev proxy (/api → http://127.0.0.1:8000).
# In production, set this to the public URL of your Laravel API, e.g. https://api.humascale.com/api
VITE_API_BASE_URL=

# Optional: override the dev proxy target
VITE_API_PROXY=http://127.0.0.1:8000
